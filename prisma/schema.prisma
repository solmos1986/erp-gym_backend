generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id   String @id @default(uuid())
  name String @unique

  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  logoUrl             String?
  costMethod CostMethod @default(WEIGHTED_AVERAGE)
  agents              Agent[]
  branches            Branch[]
  commands            Command[]
  companyPermissions  CompanyPermission[]
  customerMemberships CustomerMembership[]
  devices             Device[]
  membershipSales     MembershipSale[]
  partners            Partner[]
  plans               Plan[]
  role                Role[]
  users               User[]
  userRoles           UserRole[]
  products            Product[]
  productCategories   ProductCategory[]
  inventoryMovements  InventoryMovement[]
  cashRegisters       CashRegister[]
  cashMovements       CashMovement[]
  payments            Payment[]
  Sale                Sale[]
  purchases           Purchase[]
  businessTemplateId  String?
  businessTemplate    BusinessTemplate?    @relation(fields: [businessTemplateId], references: [id])
  ProductBoms         ProductBom[]
  productionOrders    ProductionOrder[]
  productBranches ProductBranch[]
}
enum CostMethod {
  WEIGHTED_AVERAGE
  FIFO
  STANDARD
}
model User {
  id                        String              @id @default(uuid())
  email                     String              @unique
  password                  String
  fullName                  String
  isActive                  Boolean             @default(true)
  companyId                 String
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  branchId                  String
  isOwner                   Boolean             @default(false)
  membershipSales           MembershipSale[]
  branch                    Branch              @relation(fields: [branchId], references: [id])
  company                   Company             @relation(fields: [companyId], references: [id])
  roles                     UserRole[]
  inventoryMovementsCreated InventoryMovement[] @relation("InventoryMovementCreatedBy")
  openedCashRegisters       CashRegister[]      @relation("CashRegisterOpenedBy")
  closedCashRegisters       CashRegister[]      @relation("CashRegisterClosedBy")
  cashMovements             CashMovement[]
  cancelledCashMovements    CashMovement[]      @relation("CashMovementCancelledBy")
  sales                     Sale[]
  purchases                 Purchase[]
  requestedProductionOrders ProductionOrder[]   @relation("ProductionRequestedBy")
  startedProductionOrders   ProductionOrder[]   @relation("ProductionStartedBy")
  finishedProductionOrders  ProductionOrder[]   @relation("ProductionFinishedBy")

  @@index([companyId])
  @@index([branchId])
}

model Role {
  id             String           @id @default(uuid())
  name           String
  scope          RoleScope
  companyId      String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  company        Company?         @relation(fields: [companyId], references: [id])
  // NUEVO
  roleTemplateId String?
  roleTemplate   RoleTemplate?    @relation(fields: [roleTemplateId], references: [id])
  permissions    RolePermission[]
  users          UserRole[]

  @@unique([name, scope, companyId])
}

model Permission {
  id                          String                       @id @default(uuid())
  code                        String                       @unique
  description                 String?
  scope                       RoleScope
  isActive                    Boolean                      @default(true)
  companyPermissions          CompanyPermission[]
  roles                       RolePermission[]
  businessTemplatePermissions BusinessTemplatePermission[]
  roleTemplatePermissions     RoleTemplatePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model CompanyPermission {
  id           String     @id @default(uuid())
  companyId    String
  permissionId String
  createdAt    DateTime   @default(now())
  company      Company    @relation(fields: [companyId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([companyId, permissionId])
  @@index([companyId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId, companyId])
}

model Branch {
  id                 String               @id @default(uuid())
  name               String
  companyId          String
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  agents             Agent[]              @relation("BranchAgents")
  company            Company              @relation(fields: [companyId], references: [id])
  commands           Command[]
  memberships        CustomerMembership[]
  devices            Device[]
  membershipSales    MembershipSale[]
  users              User[]
  inventoryMovements InventoryMovement[]
  cashRegisters      CashRegister[]
  cashMovements      CashMovement[]
  payments           Payment[]
  Sale               Sale[]
  purchases          Purchase[]
  productionOrders   ProductionOrder[]
  productBranches    ProductBranch[]

  @@unique([name, companyId])
}

/// ////////////
/// ///////////
model Partner {
  id              String              @id @default(uuid())
  companyId       String
  type            PartnerType
  name            String
  document        String?
  phone           String?
  email           String?
  address         String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  imageUrl        String?
  membership      CustomerMembership?
  membershipSales MembershipSale[]
  company         Company             @relation(fields: [companyId], references: [id])
  sales           Sale[]
  purchases       Purchase[]

  @@index([companyId])
}

model Device {
  id               String       @id @default(uuid())
  name             String
  ip               String
  port             Int?
  username         String?
  password         String?
  deviceType       DeviceType
  brand            String
  isActive         Boolean      @default(true)
  companyId        String
  branchId         String
  agentId          String?
  lastSeenAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  lastConnectionAt DateTime?
  status           DeviceStatus @default(DISCONNECTED)
  agent            Agent?       @relation(fields: [agentId], references: [id])
  branch           Branch       @relation(fields: [branchId], references: [id])
  company          Company      @relation(fields: [companyId], references: [id])

  @@unique([branchId, ip])
  @@index([companyId])
  @@index([branchId])
}

/// //////////////
/// ///////////////
model Plan {
  id              String           @id @default(uuid())
  name            String
  description     String?
  price           Decimal
  durationDays    Int
  isActive        Boolean          @default(true)
  companyId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  membershipSales MembershipSale[]
  company         Company          @relation(fields: [companyId], references: [id])

  @@unique([name, companyId])
}

model MembershipSale {
  id        String           @id @default(uuid())
  partnerId String
  planId    String
  companyId String
  startDate DateTime
  endDate   DateTime
  status    MembershipStatus @default(ACTIVE)
  price     Decimal          @db.Decimal(10, 2)
  createdAt DateTime         @default(now())
  saleDate  DateTime         @default(now())
  userId    String?
  branchId  String?
  commands  Command[]
  branch    Branch?          @relation(fields: [branchId], references: [id])
  company   Company          @relation(fields: [companyId], references: [id])
  partner   Partner          @relation(fields: [partnerId], references: [id])
  plan      Plan             @relation(fields: [planId], references: [id])
  user      User?            @relation(fields: [userId], references: [id])
  saleId    String?

  sale Sale? @relation(fields: [saleId], references: [id])

  @@index([partnerId])
  @@index([endDate])
  @@index([saleId])
}

model CustomerMembership {
  id                String           @id @default(uuid())
  customerId        String           @unique
  companyId         String
  startDate         DateTime
  endDate           DateTime
  status            MembershipStatus @default(ACTIVE)
  hikvisionUserId   String?
  deletedFromDevice Boolean          @default(false)
  lastSyncAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  branchId          String
  branch            Branch           @relation(fields: [branchId], references: [id])
  company           Company          @relation(fields: [companyId], references: [id])
  customer          Partner          @relation(fields: [customerId], references: [id])

  @@index([endDate])
}

/// //////
/// //
model Agent {
  id         String    @id @default(uuid())
  name       String
  agentKey   String    @unique
  companyId  String
  branchId   String
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  publicIp   String?
  branch     Branch    @relation("BranchAgents", fields: [branchId], references: [id])
  company    Company   @relation(fields: [companyId], references: [id])
  devices    Device[]

  @@unique([branchId, name])
  @@index([companyId])
  @@index([branchId])
  @@index([publicIp])
}

model Command {
  id               String          @id @default(uuid())
  payload          Json
  companyId        String
  branchId         String
  createdAt        DateTime        @default(now())
  executedAt       DateTime?
  error            String?
  attempts         Int             @default(0)
  type             CommandType
  status           CommandStatus   @default(PENDING)
  membershipSaleId String?
  branch           Branch          @relation(fields: [branchId], references: [id])
  company          Company         @relation(fields: [companyId], references: [id])
  membershipSale   MembershipSale? @relation(fields: [membershipSaleId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([branchId, status])
  @@index([membershipSaleId])
}

model Product {
   id String @id @default(uuid())

  companyId String
  productCategoryId String?

  code String?
  barcode String?
  name String
  description String?
  imageUrl String?

  productType ProductType @default(FINISHED_PRODUCT)
  sourceType SourceType @default(PURCHASE)

  inventoryControl Boolean @default(true)

  unit Unit @default(UNIT)

  isForSale Boolean @default(true)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company               Company @relation(fields:[companyId], references:[id])

  category            ProductCategory? @relation(fields:[productCategoryId], references:[id])

  bom                 ProductBom[]     @relation("ProductBoms")
  bomItems            ProductBomItem[] @relation("BomMaterials")

  inventoryMovements InventoryMovement[]
  purchaseDetails    PurchaseDetail[]

  productionOrderItems   ProductionOrderItem[]
  productionConsumptions ProductionConsumption[]

  productBranches ProductBranch[]

  @@index([companyId])
  @@index([productCategoryId])
  @@index([code])
  @@index([barcode])
  @@index([name])
}

enum ProductType {
  RAW_MATERIAL
  FINISHED_PRODUCT
  SERVICE
}

enum SourceType {
  PURCHASE
  PRODUCTION
  BOTH
}

enum Unit {
  UNIT
  KG
  GRAM
  LITER
  ML
  BOX
  PACKAGE
  BOTTLE
  METER
  CM
  MM
  PAIR
  ROLL
  DOZEN
}

model ProductCategory {
  id        String @id @default(uuid())
  companyId String

  name        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  products Product[]

  @@index([companyId])
}

model ProductBom {
  id String @id @default(uuid())

  companyId String
  productId String

  version Int     @default(1)
  name    String?

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  product Product @relation("ProductBoms", fields: [productId], references: [id])

  items ProductBomItem[]

  @@unique([productId, version])
  @@index([companyId])
  @@index([productId])
}

model ProductBomItem {
  id String @id @default(uuid())

  bomId String

  materialId String

  quantity Decimal @db.Decimal(18, 4)

  wastePercent Decimal @default(0) @db.Decimal(5, 2)

  notes String?

  createdAt DateTime @default(now())

  bom ProductBom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  material Product @relation("BomMaterials", fields: [materialId], references: [id])

  @@index([bomId])
  @@index([materialId])
}

model ProductionOrder {
  id String @id @default(uuid())

  // Multiempresa
  companyId String
  branchId  String?

  // Numeración
  number Int

  // Origen del documento
  originType ProductionOriginType @default(MANUAL)
  originId   String?

  // Estado general
  status ProductionStatus @default(PENDING)

  // Información
  notes String?

  // Auditoría
  requestedById String
  startedById   String?
  finishedById  String?

  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  company Company @relation(fields: [companyId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  requestedBy User  @relation("ProductionRequestedBy", fields: [requestedById], references: [id])
  startedBy   User? @relation("ProductionStartedBy", fields: [startedById], references: [id])
  finishedBy  User? @relation("ProductionFinishedBy", fields: [finishedById], references: [id])

  items ProductionOrderItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([originType])
}

enum ProductionOriginType {
  MANUAL
  SALE
}

enum ProductionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrderItem {
  id String @id @default(uuid())

  productionOrderId String

  productId String

  quantity Decimal @db.Decimal(18, 4)

  unitCost Decimal @default(0) @db.Decimal(18, 4)

  totalCost Decimal @default(0) @db.Decimal(18, 2)

  status ProductionItemStatus @default(PENDING)

  notes String?

  createdAt DateTime @default(now())

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  consumptions ProductionConsumption[]

  @@index([productionOrderId])
  @@index([productId])
  @@index([status])
}

enum ProductionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionConsumption {
  id String @id @default(uuid())

  // Relación
  productionOrderItemId String

  // Materia Prima utilizada
  materialId String

  // Cantidades calculadas
  quantity Decimal @db.Decimal(18, 4)

  // Costos al momento de producir
  unitCost  Decimal @db.Decimal(18, 4)
  totalCost Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  // Relaciones
  productionOrderItem ProductionOrderItem @relation(fields: [productionOrderItemId], references: [id], onDelete: Cascade)

  material Product @relation(fields: [materialId], references: [id])

  @@index([productionOrderItemId])
  @@index([materialId])
}
model ProductBranch {

  id String @id @default(cuid())

  companyId String
  branchId  String
  productId String

  // Inventario
  currentStock Decimal @default(0) @db.Decimal(18,6)
  costPrice    Decimal @default(0) @db.Decimal(18,6)

  // Comercial
  salePrice Decimal @default(0) @db.Decimal(18,6)

  // Configuración
  minStock     Decimal? @db.Decimal(18,6)
  maxStock     Decimal? @db.Decimal(18,6)
  reorderPoint Decimal? @db.Decimal(18,6)

  isActive Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])

  @@index([companyId])
  @@index([branchId])
  @@index([productId])
}
model InventoryMovement {
  id String @id @default(uuid())

  companyId String
  branchId  String

  productId String

  movementType InventoryMovementType

  referenceType InventoryReferenceType?
  referenceId   String?

  quantity Decimal @db.Decimal(18,6)
  unitCost    Decimal @default(0) @db.Decimal(18,6)
  totalCost    Decimal @default(0) @db.Decimal(18,6)
  notes String?

  createdById String?

  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])
  createdBy User?   @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([productId])
  @@index([createdAt])

  @@index([referenceType, referenceId])
}
enum InventoryMovementType {
  INITIAL_STOCK

  PURCHASE
  PURCHASE_CANCEL

  SALE_CANCEL
  SALE

  PRODUCTION_IN
  PRODUCTION_OUT

  ADJUSTMENT_IN
  ADJUSTMENT_OUT

  TRANSFER_IN
  TRANSFER_OUT
}

enum InventoryReferenceType {
  INITIAL_STOCK
  PURCHASE
  SALE
  PRODUCTION_ORDER
  ADJUSTMENT
  TRANSFER
}

model CashRegister {
  id String @id @default(uuid())

  companyId String
  branchId  String

  openedById String
  closedById String?

  openedAt DateTime

  closedAt DateTime?

  openingAmount Decimal @db.Decimal(12, 2)

  expectedAmount Decimal? @db.Decimal(12, 2)

  countedAmount Decimal? @db.Decimal(12, 2)

  difference Decimal? @db.Decimal(12, 2)

  notes String?

  status CashRegisterStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  openedBy User @relation("CashRegisterOpenedBy", fields: [openedById], references: [id])

  closedBy User? @relation("CashRegisterClosedBy", fields: [closedById], references: [id])

  movements CashMovement[]

  @@index([companyId])
  @@index([branchId])
  @@index([openedById])
  @@index([closedById])
  @@index([status])
  @@index([companyId, branchId, status])
}

model CashMovement {
  id String @id @default(uuid())

  companyId String
  branchId  String

  cashRegisterId String

  type CashMovementType

  amount      Decimal            @db.Decimal(12, 2)
  status      CashMovementStatus @default(ACTIVE)
  description String?

  referenceType CashReferenceType
  referenceId   String?

  createdById String

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])

  createdBy     User      @relation(fields: [createdById], references: [id])
  cancelledAt   DateTime?
  cancelledById String?

  cancelledBy User?     @relation("CashMovementCancelledBy", fields: [cancelledById], references: [id])
  payments    Payment[]

  @@index([companyId])
  @@index([branchId])
  @@index([cashRegisterId])
  @@index([createdById])
  @@index([referenceType])
  @@index([createdAt])
}

model Payment {
  id String @id @default(uuid())

  companyId String
  branchId  String

  cashMovementId String

  method PaymentMethod

  amount Decimal @db.Decimal(12, 2)

  reference String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  branch Branch @relation(fields: [branchId], references: [id])

  cashMovement CashMovement @relation(fields: [cashMovementId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([cashMovementId])
  @@index([method])
  @@index([createdAt])
}

model Sale {
  id String @id @default(uuid())

  companyId  String
  branchId   String?
  userId     String?
  saleNumber Int?
  customerId String?

  saleDate DateTime @default(now())

  subtotal Decimal @db.Decimal(18, 2)
  discount Decimal @default(0) @db.Decimal(18, 2)
  tax      Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @db.Decimal(18, 2)

  status SaleStatus @default(CONFIRMED)

  notes String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cancelledById String?
  cancelledAt   DateTime?

  fulfillmentStatus FulfillmentStatus @default(PENDING)

  company  Company  @relation(fields: [companyId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
  customer Partner? @relation(fields: [customerId], references: [id])

  details SaleDetail[]

  MembershipSale MembershipSale[]

  @@index([companyId])
  @@index([branchId])
  @@index([customerId])
  @@index([saleDate])
  @@index([status])
  @@index([userId])
}

model SaleDetail {
  id String @id @default(uuid())

  saleId String

  itemType SaleItemType

  itemId String?

  code        String?
  description String

  quantity Decimal @default(1) @db.Decimal(18, 2)

  unitPrice Decimal @db.Decimal(18, 2)

  unitCost Decimal @db.Decimal(10, 2)

  discount Decimal @default(0) @db.Decimal(18, 2)

  total Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([itemType])
}

model Purchase {
  id String @id @default(uuid())

  companyId      String
  branchId       String
  userId         String?
  purchaseNumber Int?
  supplierId     String

  purchaseDate DateTime @default(now())

  subtotal Decimal @db.Decimal(18, 2)
  discount Decimal @default(0) @db.Decimal(18, 2)
  tax      Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @db.Decimal(18, 2)

  status PurchaseStatus @default(CONFIRMED)

  notes String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cancelledById String?
  cancelledAt   DateTime?

  company  Company          @relation(fields: [companyId], references: [id])
  branch   Branch           @relation(fields: [branchId], references: [id])
  supplier Partner          @relation(fields: [supplierId], references: [id])
  user     User?            @relation(fields: [userId], references: [id])
  details  PurchaseDetail[]

  @@index([companyId])
  @@index([branchId])
  @@index([supplierId])
  @@index([purchaseDate])
  @@index([status])
  @@index([userId])
}

model PurchaseDetail {
  id String @id @default(uuid())

  purchaseId String
  productId  String

  code        String?
  description String

  quantity Decimal @db.Decimal(18, 2)

  unitCost Decimal @db.Decimal(18, 2)

  total Decimal @db.Decimal(18, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model BusinessTemplate {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions      BusinessTemplatePermission[]
  companies        Company[]
  roleTemplates    RoleTemplate[]
  accountTemplates AccountTemplate[]
}

model BusinessTemplatePermission {
  id String @id @default(uuid())

  businessTemplateId String
  permissionId       String

  businessTemplate BusinessTemplate @relation(fields: [businessTemplateId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([businessTemplateId, permissionId])
}

model RoleTemplate {
  id String @id @default(uuid())

  name String

  businessTemplateId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessTemplate BusinessTemplate @relation(fields: [businessTemplateId], references: [id])

  // NUEVO
  roles Role[]

  permissions RoleTemplatePermission[]

  @@unique([businessTemplateId, name])
}

model RoleTemplatePermission {
  id String @id @default(uuid())

  roleTemplateId String
  permissionId   String

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleTemplateId, permissionId])
}

model AccountTemplate {
  id String @id @default(uuid())

  businessTemplateId String?
  businessTemplate   BusinessTemplate? @relation(fields: [businessTemplateId], references: [id])

  parentId String?
  parent   AccountTemplate?  @relation("AccountTemplateHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children AccountTemplate[] @relation("AccountTemplateHierarchy")

  code String
  name String

  accountingClass AccountingClass
  nature          AccountNature

  allowMovements Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessTemplateId, code])
  @@index([businessTemplateId])
  @@index([parentId])
}

